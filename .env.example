# =======================================================================
# PALLADIUM INTEGRATION API - Environment Configuration Template
# =======================================================================
# Copy this file to .env and update the values according to your setup
# This example file can be safely committed to version control

# =======================================================================
# FLASK APPLICATION SETTINGS
# =======================================================================
FLASK_ENV=development
HOST=127.0.0.1
SECRET=your-secret-key-here

# =======================================================================
# DATABASE CONFIGURATION
# =======================================================================
POSTGRES_DATABASE_URL=postgresql://username:password@localhost:5432/database_name
TEST_POSTGRES_DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/test_database_name

# Individual PostgreSQL parameters
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =======================================================================
# EMAIL CONFIGURATION FOR PASSWORD RESET
# =======================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@eprcug.org
FROM_NAME=Palladium Integration API

# =======================================================================
# FRONTEND APPLICATION SETTINGS
# =======================================================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =======================================================================
# OPTIONAL SETTINGS
# =======================================================================
PASSWORD_RESET_EXPIRY_HOURS=1
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
DEBUG=true