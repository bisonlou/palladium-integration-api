# Email Configuration for Password Reset
# Copy this to your environment variables or .env file

# SMTP Server Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Settings
FROM_EMAIL=noreply@eprcug.org
FROM_NAME=Palladium Integration API

# Frontend URL for reset links
FRONTEND_URL=http://localhost:3000

# Required for JWT tokens (should already exist)
SECRET=your-secret-key-here

# Example Gmail App Password Setup:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to Google Account settings > Security > App passwords
# 3. Generate an app password for "Mail"
# 4. Use that app password as SMTP_PASSWORD

# Example for other email providers:
# 
# Outlook/Hotmail:
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587
#
# Yahoo:
# SMTP_SERVER=smtp.mail.yahoo.com
# SMTP_PORT=587
#
# Custom SMTP:
# SMTP_SERVER=mail.your-domain.com
# SMTP_PORT=587